NODE_ENV=development
API_PORT=3000
LOG_LEVEL=debug

# Rol de privilegios mínimos que usa la API.
DATABASE_URL=postgres://app_runtime:app_runtime@localhost:5432/anderp
# Rol dueño del esquema; solo lo usan drizzle-kit y las migraciones.
DATABASE_URL_MIGRATIONS=postgres://postgres:postgres@localhost:5432/anderp

# F01 — auth. JWT_SECRET: al menos 32 caracteres aleatorios (openssl rand -base64 48).
JWT_SECRET=dev-only-secret-change-me-0123456789abcdef
WEB_URL=http://localhost:5173
AUTH_THROTTLE_LIMIT=10

# F01 — correo. En local, Mailpit (docker compose): bandeja en http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AndERP <no-reply@anderp.local>"

# Seed (pnpm db:seed): organización inicial y super admin.
SEED_ORG_NAME="Mi Empresa S.A.S."
SEED_ORG_TAX_ID=900000000-1
SEED_SUPERADMIN_EMAIL=admin@anderp.local
SEED_SUPERADMIN_PASSWORD=cambia-esta-clave-local
SEED_SUPERADMIN_FIRST_NAME=Super
SEED_SUPERADMIN_LAST_NAME=Admin

# F06 — cifrado de credenciales. Cada llave: openssl rand -base64 32 (solo para desarrollo).
# Rotar: agrega la nueva versión, cambia la activa y ejecuta pnpm credentials:rotate.
CREDENTIALS_KEYS={"1":"ZGV2LW9ubHkta2V5LWNoYW5nZS1tZS0wMTIzNDU2Nzg="}
CREDENTIALS_ACTIVE_KEY_VERSION=1

# F07 — secreto compartido con el proxy de la web (Pages Function). Vacío en desarrollo.
# En producción es obligatorio: openssl rand -base64 48
PROXY_SECRET=
