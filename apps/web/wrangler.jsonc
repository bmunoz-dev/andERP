// F07: la web se publica como Worker con archivos estáticos (Workers Builds ejecuta `wrangler deploy`).
// El nombre debe coincidir con el del Worker creado en el panel de Cloudflare.
{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "anderp",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Rutas de la SPA (/egresos, /honorarios/…) devuelven index.html.
    "not_found_handling": "single-page-application",
    // El código del Worker solo corre en /api/*; lo demás son archivos estáticos.
    "run_worker_first": ["/api/*"],
  },
  // La URL de la API no es secreta: viaja con el código. PROXY_SECRET es un secreto del panel
  // (Settings → Runtime variables and secrets) y `wrangler deploy` no lo toca.
  "vars": { "API_ORIGIN": "https://anderp-api.onrender.com" },
  "keep_vars": true,
  "observability": { "enabled": true },
}
