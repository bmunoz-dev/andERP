{
  "name": "anderp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @anderp/shared build && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm --filter @anderp/shared build && eslint .",
    "typecheck": "pnpm --filter @anderp/shared build && pnpm -r typecheck",
    "test": "pnpm --filter @anderp/shared build && vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @anderp/api db:generate",
    "db:generate:custom": "pnpm --filter @anderp/api db:generate:custom",
    "db:migrate": "pnpm --filter @anderp/api db:migrate",
    "db:seed": "pnpm --filter @anderp/shared build && pnpm --filter @anderp/api db:seed",
    "credentials:rotate": "pnpm --filter @anderp/shared build && pnpm --filter @anderp/api credentials:rotate",
    "test:e2e": "pnpm --filter @anderp/shared build && pnpm --filter @anderp/e2e test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
